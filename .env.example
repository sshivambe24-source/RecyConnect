# RecyConnect Environment Variables
# For local development and production deployments

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Optional - dual-layer store operates seamlessly without credentials in demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-Side Supabase Service Key (Never exposed to client browser)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
